<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>
	<!-- La completa "Configurar base de datos" durante la instalacion.
	     Mientras tenga #SQLINSTANCE#, SIGAM no se conecta y pide ejecutar esa opcion. -->
	<connectionStrings>
		<add name="ConexionBD"
			 connectionString="Data Source=#SQLINSTANCE#;Initial Catalog=SIGAM;Integrated Security=True;TrustServerCertificate=True"
			 providerName="System.Data.SqlClient" />
		<add name="ConexionMaster"
			 connectionString="Data Source=#SQLINSTANCE#;Initial Catalog=master;Integrated Security=True;TrustServerCertificate=True"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>
