<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>
	<connectionStrings>
		<!-- [INSTALADOR v2] valor original (marcador que reemplazaba el instalador v1):
		<add name="ConexionBD"
			 connectionString="Data Source=#SQLINSTANCE#;Initial Catalog=BD_64PR;Integrated Security=True;TrustServerCertificate=True"
			 providerName="System.Data.SqlClient" />
		<add name="ConexionMaster"
			 connectionString="Data Source=#SQLINSTANCE#;Initial Catalog=master;Integrated Security=True;TrustServerCertificate=True"
			 providerName="System.Data.SqlClient" />
		-->
		<!-- Valores de desarrollo. En una PC instalada, el configurador de BD reescribe ambas entradas. -->
		<add name="ConexionBD"
			 connectionString="Data Source=.;Initial Catalog=BD_64PR;Integrated Security=True;TrustServerCertificate=True"
			 providerName="System.Data.SqlClient" />
		<add name="ConexionMaster"
			 connectionString="Data Source=.;Initial Catalog=master;Integrated Security=True;TrustServerCertificate=True"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>