<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>
	<!-- Las reescribe el propio configurador (ConfiguracionConexionJP86) antes de usar DAL_64PR.Acceso,
	     para que la DV y el backup existentes trabajen sobre la base de datos elegida. -->
	<connectionStrings>
		<add name="ConexionBD"
			 connectionString="Data Source=#SQLINSTANCE#;Initial Catalog=master;Integrated Security=True;TrustServerCertificate=True"
			 providerName="System.Data.SqlClient" />
		<add name="ConexionMaster"
			 connectionString="Data Source=#SQLINSTANCE#;Initial Catalog=master;Integrated Security=True;TrustServerCertificate=True"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>
